# ── Configuração de e-mail (SMTP) ─────────────────────────────────────────────
# Gmail: use uma "Senha de app" (não sua senha normal)
# https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app

# Destinatário do relatório mensal (pode ser o mesmo e-mail)
EMAIL_DEST=seu_email@gmail.com

# ── Parâmetros da carteira ─────────────────────────────────────────────────────
# Valor total atual do portfólio (usado quando posicoes.csv não existe)
PORTFOLIO_VALUE=10000

# Meta de renda mensal desejada (sobrescreve config.py)
META_MENSAL=3000

# Aporte mensal adicional para simulação DRIP
APORTE_MENSAL=0
